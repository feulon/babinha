# Production settings (see docs/producao.md). `scripts/baba.sh subir` creates .env.production
# from this file on the first run, filling in the secrets and the notebook's address; you can
# also copy it by hand. The copy is ignored by git, keep it private (chmod 600).
# Never commit real values. Values with spaces need double quotes; avoid "$" and "#" in values.

# =============================================================================================
# PART 1 - v0 LOCAL: the notebook on the home network (phones on the same wifi), no domain
# =============================================================================================

# Address the players type, then localhost (the container healthcheck calls http://localhost:8000).
# Use the notebook's fixed IP on the home network (reserve it in the router).
DJANGO_ALLOWED_HOSTS=192.0.2.10,localhost
# 50+ random characters: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
# Hex only, so it is safe inside the DATABASE_URL: openssl rand -hex 24
POSTGRES_PASSWORD=
# Production must be false. BABA_FAKE_NOW must stay unset and BABA_DEMO must stay off: the app
# refuses to start in production otherwise (compose.prod.yaml sets BABA_PRODUCTION=true).
DJANGO_DEBUG=false

# Receipts on the notebook's disk, through a small S3 gateway container ("local-receipts" profile).
# The keys are only used between the app and that container: make up any random pair.
COMPOSE_PROFILES=local-receipts
BABA_S3_ACCESS_KEY_ID=
BABA_S3_SECRET_ACCESS_KEY=
BABA_S3_BUCKET=baba-comprovantes

# Where players open the app: http://<IP>:APP_PORT (80 = just http://<IP>). If something else on
# the notebook uses port 80, set 8000. APP_BIND=127.0.0.1 would restrict it to the notebook.
APP_PORT=80

# E-mail is optional (password recovery for players who registered an e-mail). Without a real
# SMTP server "esqueci a senha" fails for those players; the others ask the diretoria.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL="Babinha <baba@localhost>"

# Code the group types on the sign-up page, so only people you invite can create an account.
# Required: the app refuses to start without it. `scripts/baba.sh subir` makes one up; change it
# any time (accounts that already exist are not affected). Share it in the group, not publicly.
BABA_INVITE_CODE=

BABA_LIST_OPENS_AT=08:00
# Optional: contact e-mail shown on the "Sobre o app" screen. Empty hides the contact.
BABA_CREATOR_EMAIL=
# Gunicorn workers (each login hashes with Argon2, about 100 MB of RAM at that moment)
WEB_CONCURRENCY=3
LOG_LEVEL=INFO

# --- Backup (scripts/backup.sh): every setting is optional ----------------------------------
# Folder for the copies; point it at an external disk. Default: ./backups
BABA_BACKUP_DIR=
# If set, the backup refuses to run unless this folder is a mounted disk (so a forgotten
# external disk does not silently fill the internal one), e.g. /mnt/disco-externo
BABA_BACKUP_MOUNTPOINT=
# Days to keep copies
BABA_BACKUP_RETENTION_DAYS=30
# Volume with the receipts (local-receipts profile) to be copied together with the database
BABA_BACKUP_RECEIPTS_VOLUME=baba-prod_s3-data
# Encrypt the copies with this passphrase file (gpg). Empty = no encryption.
BABA_BACKUP_PASSPHRASE_FILE=
# Also upload to an rclone remote, e.g. r2:baba-backups (see docs/producao.md). Empty = off.
BABA_BACKUP_REMOTE=

# =============================================================================================
# PART 2 - OPTIONAL: public on the internet through a Cloudflare Tunnel (needs a domain)
# =============================================================================================
# Uncomment and fill in. scripts/baba.sh adds compose.prod.tunnel.yaml by itself when
# TUNNEL_TOKEN is set; that file takes the port off the home network and defaults the HTTPS
# settings below.
#
# Token of the tunnel (Cloudflare Zero Trust > Networks > Tunnels > your tunnel)
# TUNNEL_TOKEN=
# Public host first, keep localhost
# DJANGO_ALLOWED_HOSTS=babinha.SEUDOMINIO.com.br,localhost
# DJANGO_CSRF_TRUSTED_ORIGINS=https://babinha.SEUDOMINIO.com.br
# The tunnel terminates HTTPS: both true
# DJANGO_BEHIND_HTTPS_PROXY=true
# DJANGO_SECURE_COOKIES=true
# HSTS, gradual: 3600 (1 hour); after a week without problems 86400, then 31536000.
# DJANGO_HSTS_SECONDS=3600
# Cloudflare sets this header with the real visitor IP (login attempts are limited per IP).
# BABA_CLIENT_IP_HEADER=HTTP_CF_CONNECTING_IP
#
# Receipts in a private Cloudflare R2 bucket instead of the disk (optional): delete the
# COMPOSE_PROFILES line above and fill in, with a token limited to that bucket:
# BABA_S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# BABA_S3_REGION=auto
# (and BABA_S3_BUCKET, BABA_S3_ACCESS_KEY_ID, BABA_S3_SECRET_ACCESS_KEY with the R2 values;
#  then BABA_BACKUP_RECEIPTS_VOLUME is not needed)
