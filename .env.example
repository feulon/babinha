# Copy to .env and adjust. Never commit .env.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Public origin(s) when served over HTTPS, e.g. https://babinha.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# true when the site is served over HTTPS (cookies only sent over HTTPS)
DJANGO_SECURE_COOKIES=false
# true when a proxy/tunnel terminates HTTPS and sets X-Forwarded-Proto
DJANGO_BEHIND_HTTPS_PROXY=false
# HSTS max-age in seconds once the site is HTTPS-only (0 = off)
DJANGO_HSTS_SECONDS=0

# Database (compose sets this for the app container)
DATABASE_URL=postgres://baba:baba@localhost:5432/baba
POSTGRES_PASSWORD=baba

# E-mail (password recovery) over plain SMTP. Compose points the app at Mailpit.
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=Babinha <baba@localhost>

# Pix receipts: a private bucket in any S3-compatible service. Compose points the app at its
# own gateway (service "s3"); outside compose, set the endpoint of your provider.
# Empty endpoint = AWS S3. Empty keys = boto3's credential chain (AWS_* variables, roles).
BABA_S3_ENDPOINT_URL=http://localhost:7070
BABA_S3_BUCKET=baba-comprovantes
BABA_S3_REGION=us-east-1
BABA_S3_ACCESS_KEY_ID=baba
BABA_S3_SECRET_ACCESS_KEY=change-me-to-a-long-random-string
# "path" works everywhere; some providers prefer "virtual"
BABA_S3_ADDRESSING_STYLE=path

# Baba
# Monday hour (America/Sao_Paulo) when the list opens for mensalistas and avulsos
BABA_LIST_OPENS_AT=08:00
# Code asked on the sign-up page. Empty = anyone can sign up (fine for development);
# required in production (.env.production.example)
BABA_INVITE_CODE=
# How long a password-reset link stays valid, in seconds
BABA_PASSWORD_RESET_TIMEOUT_SECONDS=3600
# Header with the real client IP behind a trusted proxy, e.g. HTTP_CF_CONNECTING_IP. Empty = REMOTE_ADDR
# For comma-separated headers (HTTP_X_FORWARDED_FOR) the last entry, appended by the proxy, is used
BABA_CLIENT_IP_HEADER=
# Optional: contact e-mail shown on the "Sobre o app" screen. Empty = the contact is hidden
BABA_CREATOR_EMAIL=
# Testing only, never in production (needs DJANGO_DEBUG): BABA_FAKE_NOW (Sao Paulo time,
# e.g. 2026-10-15T20:00) starts the app's clock at that moment
# BABA_FAKE_NOW=
# Testing only, never in production (the app refuses to start): BABA_DEMO=true releases the
# game day schedule and shows a banner on every screen. Use compose.demo.yaml (README) instead
# of setting it here.
# BABA_DEMO=false
